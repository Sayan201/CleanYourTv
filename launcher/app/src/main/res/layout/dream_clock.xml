<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dreamWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:id="@+id/dreamScrim"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:id="@+id/dreamClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="92sp"
                android:fontFamily="@font/outfit_light"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowRadius="12"
                android:shadowDy="2"
                android:shadowDx="0" />

            <TextClock
                android:id="@+id/dreamAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="16dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#CCFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:shadowColor="#B3000000"
                android:shadowRadius="8"
                android:shadowDy="2"
                android:shadowDx="0" />
        </LinearLayout>

        <TextClock
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#E6FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:shadowColor="#B3000000"
            android:shadowRadius="8"
            android:shadowDy="2"
            android:shadowDx="0" />
    </LinearLayout>
</FrameLayout>
