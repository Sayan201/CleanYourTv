<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3D000000" />
            <stroke android:width="2dp" android:color="#E61A1A1A" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#26000000" android:endColor="#12000000" />
            <stroke android:width="1dp" android:color="#33000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
