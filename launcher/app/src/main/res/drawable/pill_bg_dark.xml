<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E61A1A1A" />
            <stroke android:width="1.5dp" android:color="#FF111111" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#592A6BB5" />
            <stroke android:width="1.5dp" android:color="#FF1A4E8C" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2B000000" android:endColor="#14000000" />
            <stroke android:width="1dp" android:color="#33000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
